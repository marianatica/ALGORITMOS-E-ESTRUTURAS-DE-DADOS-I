bool lemonadeChange(int* bills, int billsSize) {
//o programa precisa de alguma forma verificar as notas de 5 e de 10 para ver se ter ou nao troco

    int count5 = 0, count10 = 0;

    for(int i = 0; i < billsSize; i++){
        if(bills[i] == 5){
            count5++;
        } else if(bills[i] == 10 && count5 >= 1){
            count10++;
            count5--;   
        } else if(bills[i] == 20 && (count10 > 0 && count5 > 0)){
            count10--;
            count5--; 
        } else if(bills[i] == 20 && (count10 == 0 && count5 >= 3)){
            count5 -= 3;
        }  
        else {
            return false;
        }
    }
    return true;
}
