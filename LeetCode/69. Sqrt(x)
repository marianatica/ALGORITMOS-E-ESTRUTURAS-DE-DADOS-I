int mySqrt(int x) {

    if (x == 0 || x == 1) {
        return x;
    }

    int left = 1;
    int right = x;
    int result = 0;

    while (left <= right) {

        int middle = left + (right-left)/2;
        int square = middle*middle;

        if (square == x) {
            return middle;
        }
        else if (square < x) {
            result = middle;
            left = middle + 1;
        }
        else {
            right = middle - 1;
        }
    }
    return result;
}
